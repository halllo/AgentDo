<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>13.0</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageId>AgentDo</PackageId>
		<Version>1.0.0</Version>
		<Authors>Manuel Naujoks</Authors>
		<Product>AgentDo</Product>
		<Description>Light-weight function-calling abstraction.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/halllo/AgentDo</PackageProjectUrl>
		<RepositoryUrl>https://github.com/halllo/AgentDo</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<!-- Consumers get IntelliSense, and a debugger can step into the package. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

		<!-- The .NET analyzers are off by default for a netstandard2.0 TFM, which hid a real
		     logging bug. The library is at zero warnings, so keep it that way. -->
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisMode>Recommended</AnalysisMode>

		<!-- Undocumented public members are a separate cleanup; do not fail the build on them. -->
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="\" />
		<None Include="../LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.101.1" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
		<PackageReference Include="OpenAI" Version="2.13.0" />
		<PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
		<PackageReference Include="System.Text.Json" Version="10.0.11" />
	</ItemGroup>

</Project>
